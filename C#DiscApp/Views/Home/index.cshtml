@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Home</title>
    <style>
        .feature-box {
            margin-top: 20px;
            padding: 20px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }
    </style>
</head>
<body>
    <div class="text-center">
        <h2>Welcome to C_DiscApp</h2>
        <p>Discover, manage, and play disc golf like never before.</p>
    </div>
    <div class="container">
        <div class="row">
            <div class="col-md-4 feature-box">
                <h4>Manage Your Discs</h4>
                <p>Keep track of all your discs, including details like type, weight, speed, and more.</p>
            </div>
            <div class="col-md-4 feature-box">
                <h4>Find Courses</h4>
                <p>Use our course finder to locate the nearest disc golf courses and get details about them.</p>
            </div>
            <div class="col-md-4 feature-box">
                <h4>Track Your Games</h4>
                <p>Log your game history and view scores for each hole you play.</p>
            </div>
        </div>
    </div>
</body>
</html>