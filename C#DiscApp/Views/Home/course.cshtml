@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <title>Find Nearest Disc Golf Courses</title>
    <style>
        #courseInfo {
            margin-top: 20px;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        .loading {
            font-weight: bold;
            color: blue;
        }

        .error {
            color: red;
        }

        .course {
            margin-bottom: 20px;
        }

            .course button {
                margin-top: 10px;
            }

            .course .hole-input {
                margin-top: 10px;
            }
    </style>
    <script>
        function getLocation() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(showPosition, showError);
            } else {
                alert("Geolocation is not supported by this browser.");
            }
        }

        function showPosition(position) {
            var latitude = position.coords.latitude;
            var longitude = position.coords.longitude;

            document.getElementById("courseInfo").innerText = "Loading...";
            fetch(`/Course/SearchNearestCourse?latitude=${latitude}&longitude=${longitude}`)
                .then(response => response.json())
                .then(data => {
                    var courseInfoDiv = document.getElementById("courseInfo");
                    courseInfoDiv.innerHTML = "";

                    if (data.error) {
                        courseInfoDiv.innerText = `Error: ${data.error}`;
                    } else if (data.message) {
                        courseInfoDiv.innerText = data.message;
                    } else {
                        data.forEach(course => {
                            var courseElement = document.createElement("div");
                            courseElement.classList.add("course");
                            var distance = course.distance.toFixed(2) + " km";
                            courseElement.innerHTML = `
                                        <strong>Course:</strong> ${course.name}<br>
                                        <strong>Address:</strong> ${course.address}<br>
                                        <strong>Distance:</strong> ${distance}<br>
                                        <div class="hole-input">
                                            <label for="holes-${course.name}">Number of Holes:</label>
                                            <input type="number" id="holes-${course.name}" name="numberOfHoles" min="1" value="9" />
                                        </div>
                                        <button onclick="playHere('${course.name}', '${course.address}', ${course.distance}, document.getElementById('holes-${course.name}').value)">Play here</button>
                                    `;
                            courseInfoDiv.appendChild(courseElement);
                            courseInfoDiv.appendChild(document.createElement("hr")); // Add a separator
                        });
                    }
                })
                .catch(error => {
                    document.getElementById("courseInfo").innerText = `Fetch error: ${error.message}`;
                });
        }

        function playHere(name, address, distance, numberOfHoles) {
            var url = `/Play/Start?name=${encodeURIComponent(name)}&address=${encodeURIComponent(address)}&distance=${distance}&numberOfHoles=${numberOfHoles}`;
            window.location.href = url;
        }

        function showError(error) {
            let errorMessage = "";
            switch (error.code) {
                case error.PERMISSION_DENIED:
                    errorMessage = "User denied the request for Geolocation.";
                    break;
                case error.POSITION_UNAVAILABLE:
                    errorMessage = "Location information is unavailable.";
                    break;
                case error.TIMEOUT:
                    errorMessage = "The request to get user location timed out.";
                    break;
                case error.UNKNOWN_ERROR:
                    errorMessage = "An unknown error occurred.";
                    break;
            }
            document.getElementById("courseInfo").innerText = errorMessage;
        }

        window.onload = getLocation;
    </script>
</head>
<body>
    <h2>Find Nearest Disc Golf Courses</h2>
    <div id="courseInfo" class="loading">Fetching your location...</div>
</body>
</html>
