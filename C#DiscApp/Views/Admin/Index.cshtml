@model IEnumerable<C_DiscApp.Models.User>

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Admin Dashboard</h1>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.First().Email)</th>
            <th>@Html.DisplayNameFor(model => model.First().FirstName)</th>
            <th>@Html.DisplayNameFor(model => model.First().LastName)</th>
            <th>@Html.DisplayNameFor(model => model.First().DateJoined)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                <td>@Html.DisplayFor(modelItem => item.FirstName)</td>
                <td>@Html.DisplayFor(modelItem => item.LastName)</td>
                <td>@Html.DisplayFor(modelItem => item.DateJoined)</td>
                <td>
                    <a asp-action="UserDetails" asp-route-id="@item.Id" class="btn btn-info">Details</a>
                    <a asp-action="EditUser" asp-route-id="@item.Id" class="btn btn-primary">Edit</a>
                    <a asp-action="DeleteUser" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
                    <a asp-action="UserInventory" asp-route-id="@item.Id" class="btn btn-warning">Inventory</a>
                    <a asp-action="UserHistory" asp-route-id="@item.Id" class="btn btn-secondary">History</a>
                </td>
            </tr>
        }
    </tbody>
</table>
