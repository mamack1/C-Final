@model C_DiscApp.Models.GameHistoryViewModel

@{
    ViewData["Title"] = "Game History";
}

<h1>@ViewData["Title"]</h1>

@if (Model.IsAdmin)
{
    <div>
        <p>As an admin, you are seeing all game histories.</p>
    </div>
}
else
{
    <div>
        <p>Here are your previously played games.</p>
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>Course Name</th>
            <th>Number of Holes</th>
            <th>Date Played</th>
            <th>Total Par Throws</th>
            <th>Total Throws</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var game in Model.GameHistories)
        {
            <tr>
                <td>@game.CourseName</td>
                <td>@game.NumberOfHoles</td>
                <td>@game.DatePlayed.ToString("MM/dd/yyyy")</td>
                <td>@game.TotalParThrows</td>
                <td>@game.TotalThrows</td>
            </tr>
        }
    </tbody>
</table>

